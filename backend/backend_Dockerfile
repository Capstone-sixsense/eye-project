FROM python:3.11

# 2. 작업 디렉토리 설정
WORKDIR /app

# 시스템 패키지 설치
RUN apt-get update && apt-get install -y \
    git \
    git-lfs \
    fonts-noto-cjk \
    libgl1 \
    libglib2.0-0 \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# 의존성 파일 복사 및 설치
COPY backend_requirements .
RUN pip install --no-cache-dir -r backend_requirements

# 디렉토리 구조 미리 생성
RUN mkdir -p /app/data /app/storage /app/results

# AI 패키지 경로 등록 (/ai 는 docker-compose 볼륨으로 마운트)
ENV PYTHONPATH=/ai

# 소스 코드 복사 
COPY . .

EXPOSE 8000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]